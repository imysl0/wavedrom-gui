{
  "name": "wavedrom-gui-vscode",
  "displayName": "WaveDrom-Gui",
  "description": "%extension.description%",
  "version": "260914.5.0",
  "publisher": "wavedrom-gui",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/linshi-2026/wavedrom-gui"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onUri"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./media/modern-render.browser.js",
      "./media/preview.js"
    ],
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "commands": [
      {
        "command": "wavedrom-gui.openImage",
        "title": "%command.openImage.title%"
      },
      {
        "command": "wavedrom-gui.editActive",
        "title": "%command.editActive.title%",
        "category": "WaveDrom"
      },
      {
        "command": "wavedrom-gui.editFromPreview",
        "title": "%command.editFromPreview.title%",
        "category": "WaveDrom"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "wavedrom-gui.openImage",
          "when": "resourceExtname == .png || resourceExtname == .svg",
          "group": "9_wavedrom@1"
        }
      ],
      "webview/context": [
        {
          "command": "wavedrom-gui.editFromPreview",
          "when": "webviewSection == 'wavedrom' && (webviewId == 'markdown.preview' || webviewId == 'vscode.markdown.preview.editor')",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "wavedrom-gui.editFromPreview",
          "when": "false"
        },
        {
          "command": "wavedrom-gui.openImage",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "WaveDrom-Gui",
      "properties": {
        "wavedrom-gui.previewEditAffordance": {
          "type": "string",
          "enum": [
            "menu",
            "button",
            "block"
          ],
          "enumDescriptions": [
            "%config.previewEditAffordance.menu%",
            "%config.previewEditAffordance.button%",
            "%config.previewEditAffordance.block%"
          ],
          "default": "menu",
          "markdownDescription": "%config.previewEditAffordance.desc%"
        },
        "wavedrom-gui.editorPanelPosition": {
          "type": "string",
          "enum": [
            "current",
            "beside",
            "below",
            "newWindow"
          ],
          "enumDescriptions": [
            "%config.editorPanelPosition.current%",
            "%config.editorPanelPosition.beside%",
            "%config.editorPanelPosition.below%",
            "%config.editorPanelPosition.newWindow%"
          ],
          "default": "current",
          "markdownDescription": "%config.editorPanelPosition.desc%"
        },
        "wavedrom-gui.showCodeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.showCodeLens.desc%"
        },
        "wavedrom-gui.imageExportTheme": {
          "type": "string",
          "enum": [
            "auto",
            "modern",
            "traditional"
          ],
          "enumDescriptions": [
            "%config.imageExportTheme.auto%",
            "%config.imageExportTheme.modern%",
            "%config.imageExportTheme.traditional%"
          ],
          "default": "auto",
          "markdownDescription": "%config.imageExportTheme.desc%"
        },
        "wavedrom-gui.editorViewMode": {
          "type": "string",
          "enum": [
            "simple",
            "auto"
          ],
          "enumDescriptions": [
            "%config.editorViewMode.simple%",
            "%config.editorViewMode.auto%"
          ],
          "default": "auto",
          "markdownDescription": "%config.editorViewMode.desc%"
        },
        "wavedrom-gui.editorSidePanel": {
          "type": "string",
          "enum": [
            "shown",
            "auto"
          ],
          "enumDescriptions": [
            "%config.editorSidePanel.shown%",
            "%config.editorSidePanel.auto%"
          ],
          "default": "shown",
          "markdownDescription": "%config.editorSidePanel.desc%"
        },
        "wavedrom-gui.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.zh%",
            "%config.language.en%"
          ],
          "default": "auto",
          "markdownDescription": "%config.language.desc%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node test/run.js",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "markdown-it": "^15.0.1"
  }
}
